# Database Configuration (Connect to existing PostgreSQL)
DATABASE_URL=postgresql+asyncpg://complaint_user:complaint_pass_dev@localhost:5432/complaint_management

# JWT Configuration (Must match .NET settings)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=ComplaintManagement
JWT_AUDIENCE=ComplaintManagement

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Redis
REDIS_URL=redis://localhost:6379/1

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.xlsx,.xls,.jpg,.jpeg,.png,.gif

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:3001

# Server
HOST=0.0.0.0
PORT=8000

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/

# Node modules and Angular
**/node_modules/
**/dist/
**/.angular/

# IDEs
.vscode/
.idea/

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.db-shm
*.db-wal

# Sensitive files
appsettings.Development.json
*.pfx
*.p12

# Problematic Windows reserved names
**/nul
**/NUL

# Installer output
installer-output/
installer-build-output.txt

# Playwright test screenshots
.playwright-mcp/

# Test results
api_test_results.*

# Screenshots
Screenshots/
EMAIL_TICKETING_OAUTH_SETUP_GUIDE.md

# Configuration files with secrets
appsettings.json
appsettings.*.json
!appsettings.template.json

# Git credentials (local only)
.git-credentials

# Claude Code local settings
.claude/settings.local.json

# Python
**/__pycache__/
*.py[cod]
*.egg-info/
.env

# Test tokens and session data
test_token.txt
test-session-data.json
authentication-tokens.json
.email-token.json
.handler-test-data.json
login-response.json
email-config-details.json
email-config-payload.json
email-config-result.txt
.oauth-url.txt
oauth-e2e-test-results.json

# Test evidence and reports
test-evidence/
playwright-report/
test-screenshots/
escalation-test-screenshots/

# Ad-hoc test scripts
test-tender-backend.ps1

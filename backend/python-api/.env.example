# Tender Automation API Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://sa:Admin@123@localhost:5432/ComplaintManagementDB

# JWT Settings (must match .NET API)
JWT_SECRET_KEY=your-secret-key-from-dotnet-api
JWT_ALGORITHM=HS256
JWT_ISSUER=ComplaintManagementAPI
JWT_AUDIENCE=ComplaintManagementClient

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
DEBUG=False

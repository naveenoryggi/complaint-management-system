# ================================
# APPLICATION CONFIGURATION
# ================================
NODE_ENV=development
PORT=3000
FRONTEND_PORT=3001

# ================================
# POSTGRESQL DATABASE (Complaint System)
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=complaint_user
DB_PASSWORD=change_this_password_in_production
DB_DATABASE=complaint_management

# ================================
# SQL SERVER (Oryggi HRMS - Read Only)
# ================================
ORYGGI_DB_HOST=LAPTOP-NF9BTG7Q\SQLEXPRESS
ORYGGI_DB_PORT=1433
ORYGGI_DB_USERNAME=sa
ORYGGI_DB_PASSWORD=admin@123
ORYGGI_DB_DATABASE=Oryggi
ORYGGI_DB_ENCRYPT=false
ORYGGI_DB_TRUST_SERVER_CERTIFICATE=true

# ================================
# REDIS CACHE & QUEUE
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-min-32-chars
JWT_REFRESH_EXPIRY=7d

# ================================
# EMAIL SERVICE
# ================================
EMAIL_SERVICE=ses
EMAIL_FROM=noreply@company.com
EMAIL_FROM_NAME=Complaint Management System

# AWS SES Configuration
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=your_aws_access_key
AWS_SES_SECRET_KEY=your_aws_secret_key

# SendGrid Configuration (Alternative)
SENDGRID_API_KEY=your_sendgrid_api_key

# SMTP Configuration (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ================================
# FILE UPLOAD & STORAGE
# ================================
# AWS S3 Configuration
S3_BUCKET=complaint-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# Local Storage (Development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ================================
# FRONTEND CONFIGURATION
# ================================
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# ================================
# CORS CONFIGURATION
# ================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# ================================
# ORYGGI SYNC CONFIGURATION
# ================================
ORYGGI_SYNC_ENABLED=true
ORYGGI_SYNC_INTERVAL=21600000  # 6 hours in milliseconds
ORYGGI_SYNC_ON_STARTUP=true

# ================================
# LOGGING
# ================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000

# ================================
# SESSION CONFIGURATION
# ================================
SESSION_SECRET=your-session-secret-change-in-production
SESSION_TIMEOUT=900000  # 15 minutes in milliseconds

# ================================
# MONITORING & OBSERVABILITY
# ================================
SENTRY_DSN=your_sentry_dsn
PROMETHEUS_ENABLED=true

# ================================
# MULTI-TENANT CONFIGURATION
# ================================
DEFAULT_TENANT_ID=default-tenant-uuid

# ================================
# VIRUS SCANNING (ClamAV)
# ================================
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ================================
# TIMEZONE
# ================================
TZ=Asia/Kolkata

# ================================
# SECURITY
# ================================
BCRYPT_ROUNDS=12
MFA_ENABLED=false
SESSION_SECURE=false  # Set to true in production with HTTPS

# ================================
# ESCALATION CONFIGURATION
# ================================
ESCALATION_CHECK_INTERVAL=300000  # 5 minutes
SLA_WARNING_THRESHOLD=0.2  # Alert when 20% time remaining

# ================================
# EMAIL QUEUE
# ================================
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_BATCH_SIZE=50
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=60000  # 1 minute

# ================================
# FEATURE FLAGS
# ================================
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_SSO_ENABLED=false
FEATURE_MFA_ENABLED=false
FEATURE_PWA_ENABLED=true
